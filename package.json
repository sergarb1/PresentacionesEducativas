{
  "name": "presentaciones-educativas",
  "version": "1.0.0",
  "description": "Sistema reutilizable de presentaciones educativas con Slidev",
  "license": "CC-BY-SA-4.0",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "export:pptx": "slidev export --format pptx",
    "export:png": "slidev export --format png",
    "export:dark": "slidev export --dark",
    "import": "node scripts/import-pptx.mjs",
    "import:dev": "node scripts/import-pptx.mjs && slidev output/slides.md --open"
  },
  "devDependencies": {
    "@mdgate/pptx": "^0.6.25",
    "@slidev/cli": "^51.8.2",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "playwright-chromium": "^1.63.0"
  }
}

# Dependencies
node_modules/

# Build output
dist/

# Export output (PDFs sí se versionan dentro de output/)
*.pdf
!output/*.pdf

# Root entry files (except AGENTS.md and README.md)
/*.md
!AGENTS.md
!README.md

# Local presentation sources (input/ stays out of Git; output/ is versioned)
input/*
!input/.gitkeep

# Legacy HTML source material
slides/*
!slides/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Internal
.serena/
.opencode/
